[
  {
    "name": "Highlight a verse in a named color",
    "messages": [{ "role": "user", "type": "message", "content": "Highlight Romans 8:28 in green." }],
    "expectedCall": [{ "functionName": "add_highlight", "arguments": { "reference": { "$pattern": "(?i)rom(ans)? 8:28" }, "color": { "$pattern": "(?i)^green$" } } }]
  },
  {
    "name": "Save a verse with no color given",
    "messages": [{ "role": "user", "type": "message", "content": "Save John 3:16 to my library." }],
    "expectedCall": [{ "functionName": "add_highlight", "arguments": { "reference": { "$pattern": "(?i)john 3:16" } } }]
  },
  {
    "name": "What did I highlight in a book",
    "messages": [{ "role": "user", "type": "message", "content": "What have I highlighted in Romans?" }],
    "expectedCall": [{ "functionName": "find_highlights", "arguments": { "within": { "$pattern": "(?i)^rom(ans)?$" } } }]
  },
  {
    "name": "Highlights by a library color name",
    "messages": [{ "role": "user", "type": "message", "content": "Show me everything I marked as Prayer." }],
    "expectedCall": [{ "functionName": "find_highlights", "arguments": { "color": { "$pattern": "(?i)^prayer$" } } }]
  },
  {
    "name": "Delete a highlight found first",
    "messages": [{ "role": "user", "type": "message", "content": "Remove my highlight in Psalm 23." }],
    "expectedCall": [
      {
        "functionName": "find_highlights",
        "arguments": { "within": { "$pattern": "(?i)ps(alm)? 23" } },
        "mockOutput": { "scope": "Psalm 23", "page": 1, "page_size": 12, "total_count": 1, "total_pages": 1, "highlights": [{ "reference": "Psalm 23:1–3", "color": "Blue" }], "colors": ["Yellow", "Green", "Blue", "Pink", "Purple", "Orange"] }
      },
      { "functionName": "delete_highlights", "arguments": { "reference": { "$pattern": "(?i)ps(alm)? 23:1" } } }
    ]
  },
  {
    "name": "Locked library: ask the user to sign in on the page, never share credentials",
    "messages": [
      { "role": "user", "type": "message", "content": "Highlight Philippians 4:6 in yellow." },
      { "role": "model", "type": "functioncall", "name": "add_highlight", "arguments": { "reference": "Philippians 4:6", "color": "yellow" } },
      {
        "role": "user",
        "type": "functionresponse",
        "name": "add_highlight",
        "response": { "result": { "error": "No library is open on this page.", "code": "LIBRARY_LOCKED", "retryable": false, "suggestion": "Ask the user to sign in on this page with their passkey, email code, or Apple account. Never ask them to share credentials in chat." } }
      }
    ],
    "expectedCall": []
  },
  {
    "name": "Unknown color: recover by looking up the library's colors",
    "messages": [
      { "role": "user", "type": "message", "content": "Highlight Isaiah 40:31 in my hope color." },
      { "role": "model", "type": "functioncall", "name": "add_highlight", "arguments": { "reference": "Isaiah 40:31", "color": "hope" } },
      {
        "role": "user",
        "type": "functionresponse",
        "name": "add_highlight",
        "response": { "result": { "error": "This library has no color called \"hope\".", "code": "COLOR_NOT_FOUND", "retryable": false, "suggestion": "Ask the user to pick one of the colors find_highlights lists." } }
      }
    ],
    "expectedCall": [{ "functionName": "find_highlights", "arguments": {} }]
  }
]
